rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /progress/{progressId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /test/{docId} {
      allow read: if true;
    }
  }
}
