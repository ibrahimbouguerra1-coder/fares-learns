{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account and profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid"]
    },
    "LearnerProgress": {
      "title": "LearnerProgress",
      "description": "Comprehensive learning progress and statistics for the user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "estimatedLevel": { "type": "string" },
        "skills": { "type": "object" },
        "primaryGoal": { "type": "string" },
        "dailyGoalMinutes": { "type": "number" },
        "learningMode": { "type": "string" },
        "preferredAccent": { "type": "string" },
        "xp": { "type": "number" },
        "streakDays": { "type": "number" },
        "completedLessonIds": { "type": "array" },
        "savedVocabulary": { "type": "array" },
        "personalMistakes": { "type": "array" },
        "badges": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document"
    },
    "/users/{userId}/progress/{progressId}": {
      "schema": "LearnerProgress",
      "description": "User learning progress and statistics"
    }
  }
}
